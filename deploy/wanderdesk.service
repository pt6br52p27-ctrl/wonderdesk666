[Unit]
Description=WanderDesk booking desk
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/wanderdesk
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=DELAY_MS=0
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
